{
  "manifest_version": 3,
  "name": "Bodyguard Link Checker",
  "version": "1.0.0",
  "description": "Check the active tab for scam and phishing indicators.",
  "permissions": ["storage", "tabs", "activeTab"],
  "host_permissions": ["http://127.0.0.1:4173/*", "http://localhost:4173/*"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_popup": "popup.html", "default_title": "Check this link" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }]
}
